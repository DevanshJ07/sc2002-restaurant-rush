        <mxCell id="lbl-30" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;1&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="-2" y="1084.8" as="geometry" />
        </mxCell>
        <mxCell id="lbl-31" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;1&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="804" y="976" as="geometry" />
        </mxCell>
        <mxCell id="lbl-32" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;0 .. 1&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="-2" y="1287.8" as="geometry" />
        </mxCell>
        <mxCell id="lbl-33" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;1&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="912.2" y="1470.1" as="geometry" />
        </mxCell>
        <mxCell id="lbl-34" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;1&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="906" y="1299.4" as="geometry" />
        </mxCell>
        <mxCell id="ann-key-E" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="E – Encapsulation" vertex="1">
          <mxGeometry height="30" width="150" x="-1570" y="-320" as="geometry" />
        </mxCell>
        <mxCell id="ann-key-P" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" value="P – Polymorphism" vertex="1">
          <mxGeometry height="30" width="150" x="-1410" y="-320" as="geometry" />
        </mxCell>
        <mxCell id="ann-key-C" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" value="C – Composition" vertex="1">
          <mxGeometry height="30" width="150" x="-1250" y="-320" as="geometry" />
        </mxCell>
        <mxCell id="ann-P2" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" value="&lt;b&gt;P2 · Polymorphism (substitutability) – WaitingQueue&lt;/b&gt;&lt;br&gt;waitingCustomers holds &lt;b&gt;Customer&lt;/b&gt; references, so Regular, VIP and Critic customers sit in the same list. Waiter.seatCustomer(queue, customer: Customer, table) and Table.assignCustomer(customer: Customer) likewise accept any subtype." vertex="1">
          <mxGeometry height="130" width="380" x="-1570" y="100" as="geometry" />
        </mxCell>
        <mxCell id="ann-E3" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="&lt;b&gt;E3 · Encapsulation – Table&lt;/b&gt;&lt;br&gt;currentCustomer is &lt;b&gt;private&lt;/b&gt; and isOccupied() is derived from it (currentCustomer != null), so occupancy can’t disagree with the seated customer. It only changes via assignCustomer() / freeTable()." vertex="1">
          <mxGeometry height="110" width="380" x="-1570" y="275" as="geometry" />
        </mxCell>
        <mxCell id="ann-E4" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="&lt;b&gt;E4 · Encapsulation – Customer&lt;/b&gt;&lt;br&gt;satisfaction is &lt;b&gt;private&lt;/b&gt; and has no setter. It only changes through loseSatisfaction(), which applies the customer’s own loss rate and never goes below 0, and recoverSatisfaction(amount), which never goes above MAX_SATISFACTION (100)." vertex="1">
          <mxGeometry height="110" width="380" x="-1570" y="430" as="geometry" />
        </mxCell>
        <mxCell id="ann-P1" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" value="&lt;b&gt;P1 · Polymorphism (overriding) – Customer&lt;/b&gt;&lt;br&gt;Customer declares &lt;b&gt;abstract&lt;/b&gt; getSatisfactionLossRate(), applyPricing() and getTypeLabel(); RegularCustomer, VIPCustomer and CriticCustomer each override them. calculateBill() is a final &lt;b&gt;template method&lt;/b&gt;: it rejects a negative price once, then calls the subtype's applyPricing(). Code written against Customer (loseSatisfaction(), Waiter.takeOrder(), Customer.toString() which the CLI prints) gets the right behaviour at runtime without checking the subtype. CriticCustomer also overrides the concrete chooseItem(menu)." vertex="1">
          <mxGeometry height="165" width="380" x="-1990" y="790" as="geometry" />
        </mxCell>
        <mxCell id="ann-E1" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="&lt;b&gt;E1 · Encapsulation – Order&lt;/b&gt;&lt;br&gt;All state is private (menuItem, status, remainingPrepUnits, billInCents). There are no setters for status or bill: the status only moves through guarded transitions (decrementPrepUnit, markServed, markPaid, cancel) and the bill is fixed at construction (only applyDiscount can lower it, and only while IN_PROGRESS). An order can never jump to an invalid state such as IN_PROGRESS → PAID." vertex="1">
          <mxGeometry height="150" width="380" x="-1570" y="1355" as="geometry" />
        </mxCell>
        <mxCell id="ann-P3" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" value="&lt;b&gt;P3 · Polymorphism (substitutability) – ComboMeal&lt;/b&gt;&lt;br&gt;A ComboMeal &lt;b&gt;is a&lt;/b&gt; MenuItem, so Menu, Order, Chef and billing treat it like any other item. Stage 3 needs no change to ordering or cooking." vertex="1">
          <mxGeometry height="120" width="380" x="-1990" y="1540" as="geometry" />
        </mxCell>
        <mxCell id="ann-C1" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" value="&lt;b&gt;C1 · Composition – Menu ◆— MenuItem (1..*)&lt;/b&gt;&lt;br&gt;The filled diamond means Menu owns its items: it creates and keeps the private item list, items only join through addItem() (no null, no duplicate names) and other classes only get a read-only view from getItems(). Main creates each MenuItem once and hands it straight to the Menu, so the items live and die with it." vertex="1">
          <mxGeometry height="135" width="380" x="-1570" y="1790" as="geometry" />
        </mxCell>
        <mxCell id="ann-C2" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" value="&lt;b&gt;C2 · Composition – GameController ◆— its ten parts&lt;/b&gt;&lt;br&gt;GameController &lt;b&gt;owns&lt;/b&gt; Table, Waiter, Chef, Cashier, Host, WaitingQueue, Menu, PolicyManager and ArrivalSchedule: Main.createGame() builds each part once and passes it to the GameController constructor, which keeps it in a private final field for the whole game. Nothing else holds the parts, so they live and die with the controller and each uses a filled diamond (Table 1..*; Waiter, Chef, Cashier, WaitingQueue, Menu, ArrivalSchedule 1 each; Host and PolicyManager 0..1, because the core-only constructor passes null). GameStats is created by GameController itself (new GameStats()), so it is composition too (1). Contrast: a hollow diamond (aggregation) would mean the part can exist without the controller." vertex="1">
          <mxGeometry height="170" width="400" x="1230" y="560" as="geometry" />
        </mxCell>
        <mxCell id="ann-E2" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="&lt;b&gt;E2 · Encapsulation – PolicyManager&lt;/b&gt;&lt;br&gt;happyHourRemainingTurns and happyHourHasBeenUsed are &lt;b&gt;private&lt;/b&gt;, and happyHourActive is &lt;b&gt;derived&lt;/b&gt; (happyHourRemainingTurns &amp;gt; 0) rather than stored, so it can’t disagree with the timer. Other classes can only change this state through activateHappyHour() (which throws if already used), decrementHappyHourTimer() and applyDiscount(order), so the happy-hour rules (once per game, 2 turns, 20% off, +15 recovery) live in one place and can’t be bypassed." vertex="1">
          <mxGeometry height="140" width="360" x="120" y="1560" as="geometry" />
        </mxCell>
        <mxCell id="dep-gc-customer" edge="1" parent="1" source="GameController" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5006;exitDx=0;exitDy=0;entryX=1;entryY=0.7095;entryDx=0;entryDy=0;endArrow=open;endFill=0;dashed=1;" target="Customer" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dep-gc-order" edge="1" parent="1" source="GameController" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.7713;exitDx=0;exitDy=0;entryX=1;entryY=0.2325;entryDx=0;entryDy=0;endArrow=open;endFill=0;dashed=1;" target="Order" value="">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="1130" /><mxPoint x="480" y="1178" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="dep-host-customer" edge="1" parent="1" source="Host" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.2882;entryDx=0;entryDy=0;endArrow=open;endFill=0;dashed=1;" target="Customer" value="">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-680" y="292.5" /><mxPoint x="-680" y="748" /></Array></mxGeometry>
        </mxCell>
      <mxCell id="stage-title" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;rounded=0;spacing=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;Restaurant Rush: Class Diagram, Stage 3&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Builds on Stage 2 and only adds: Host, PolicyManager, ComboMeal, Customer.recoverSatisfaction(), Order.applyDiscount(), GameController (host, policyManager, happyHourUsed, Phase.HOST, hostSeat(), finishHostPhase(), activateHappyHour(), hasHost(), hasPolicyManager(), isHappyHourActive(), getHappyHourRemainingTurns(), hasHappyHourBeenUsed()), GameCLI.promptHostAction(), GameCLI.promptHappyHour(). Main.createGame() now also builds the Host, the PolicyManager and the combo meal.&lt;br&gt;Final code (refactored after the stage-3 tag, same behaviour): GameStats takes over score counting and the win rule from GameController; Customer.calculateBill() is a template method over applyPricing(); setState() is replaced by seat(), abandon() and pay().&lt;/font&gt;"><mxGeometry x="-1570" y="-460" width="1700" height="90" as="geometry" /></mxCell><mxCell id="Phase" parent="1" vertex="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=54;fillColor=none;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" value="&amp;lt;&amp;lt;enumeration&amp;gt;&amp;gt;&lt;div&gt;&lt;b&gt;Phase&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;private, nested in GameController&lt;/span&gt;&lt;/div&gt;">
  <mxGeometry x="1230" y="790" width="190" height="122.0" as="geometry" /></mxCell><mxCell id="Phase-v" parent="Phase" vertex="1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" value="BETWEEN_TURNS&lt;br&gt;HOST&lt;br&gt;WAITER&lt;br&gt;CHEF">
  <mxGeometry y="54" width="190" height="68.0" as="geometry" /></mxCell><mxCell id="nest-gc-phase" edge="1" parent="1" source="GameController" target="Phase" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.3938;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=open;endFill=0;startArrow=circlePlus;startFill=0;">
  <mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="Main" parent="1" vertex="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;&amp;lt;&amp;lt;utility&amp;gt;&amp;gt;&lt;/span&gt;&lt;/div&gt;Main">
