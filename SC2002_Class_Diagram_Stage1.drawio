        <mxCell id="lbl-28" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;1&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="-2" y="679.5" as="geometry" />
        </mxCell>
        <mxCell id="lbl-29" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;1&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="804" y="881" as="geometry" />
        </mxCell>
        <mxCell id="lbl-30" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;1&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="-2" y="1084.8" as="geometry" />
        </mxCell>
        <mxCell id="lbl-33" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;1&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="912.2" y="1408.1" as="geometry" />
        </mxCell>
        <mxCell id="lbl-34" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;1&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="906" y="1240.4" as="geometry" />
        </mxCell>
        <mxCell id="ann-key-E" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="E – Encapsulation" vertex="1">
          <mxGeometry height="30" width="150" x="-1570" y="-320" as="geometry" />
        </mxCell>
        <mxCell id="ann-key-P" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" value="P – Polymorphism" vertex="1">
          <mxGeometry height="30" width="150" x="-1410" y="-320" as="geometry" />
        </mxCell>
        <mxCell id="ann-key-C" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" value="C – Composition" vertex="1">
          <mxGeometry height="30" width="150" x="-1250" y="-320" as="geometry" />
        </mxCell>
        <mxCell id="ann-P2" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" value="&lt;b&gt;P2 · Polymorphism (substitutability) – WaitingQueue&lt;/b&gt;&lt;br&gt;waitingCustomers holds &lt;b&gt;Customer&lt;/b&gt; references, so any Customer subtype (RegularCustomer in this stage) sits in the same list. Waiter.seatCustomer(queue, customer: Customer, table) and Table.assignCustomer(customer: Customer) likewise accept any subtype." vertex="1">
          <mxGeometry height="130" width="380" x="-1570" y="100" as="geometry" />
        </mxCell>
        <mxCell id="ann-E3" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="&lt;b&gt;E3 · Encapsulation – Table&lt;/b&gt;&lt;br&gt;currentCustomer is &lt;b&gt;private&lt;/b&gt; and isOccupied() is derived from it (currentCustomer != null), so occupancy can’t disagree with the seated customer. It only changes via assignCustomer() / freeTable()." vertex="1">
          <mxGeometry height="110" width="380" x="-1570" y="275" as="geometry" />
        </mxCell>
        <mxCell id="ann-E4" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="&lt;b&gt;E4 · Encapsulation – Customer&lt;/b&gt;&lt;br&gt;satisfaction is &lt;b&gt;private&lt;/b&gt; and has no setter. It starts at MAX_SATISFACTION (100) and only changes through loseSatisfaction(), which applies the customer’s own loss rate and never goes below 0." vertex="1">
          <mxGeometry height="110" width="380" x="-1570" y="430" as="geometry" />
        </mxCell>
        <mxCell id="ann-P1" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" value="&lt;b&gt;P1 · Polymorphism (overriding) – Customer&lt;/b&gt;&lt;br&gt;Customer declares &lt;b&gt;abstract&lt;/b&gt; getSatisfactionLossRate(), calculateBill() and getTypeLabel(); RegularCustomer overrides them. Code written against Customer (loseSatisfaction(), Waiter.takeOrder(), Customer.toString() which the CLI prints) gets the right behaviour at runtime without checking the subtype, so more customer types can be added later without changing it." vertex="1">
          <mxGeometry height="165" width="380" x="-1990" y="790" as="geometry" />
        </mxCell>
        <mxCell id="ann-E1" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="&lt;b&gt;E1 · Encapsulation – Order&lt;/b&gt;&lt;br&gt;All state is private (menuItem, status, remainingPrepUnits, billInCents). There are no setters for status or bill: the status only moves through guarded transitions (decrementPrepUnit, markServed, markPaid, cancel) and the bill is fixed at construction. An order can never jump to an invalid state such as IN_PROGRESS → PAID." vertex="1">
          <mxGeometry height="150" width="380" x="-1570" y="1355" as="geometry" />
        </mxCell>
        <mxCell id="ann-C1" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" value="&lt;b&gt;C1 · Composition – Menu ◆— MenuItem (1..*)&lt;/b&gt;&lt;br&gt;The filled diamond means Menu owns its items: it creates and keeps the private item list, items only join through addItem() (no null, no duplicate names) and other classes only get a read-only view from getItems(). Main creates each MenuItem once and hands it straight to the Menu, so the items live and die with it." vertex="1">
          <mxGeometry height="135" width="380" x="-1570" y="1790" as="geometry" />
        </mxCell>
        <mxCell id="ann-C2" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" value="&lt;b&gt;C2 · Composition – GameController ◆— its seven parts&lt;/b&gt;&lt;br&gt;GameController &lt;b&gt;owns&lt;/b&gt; Table, Waiter, Chef, Cashier, WaitingQueue, Menu and ArrivalSchedule: Main.createGame() builds each part once and passes it to the GameController constructor, which keeps it in a private final field for the whole game. Nothing else holds the parts, so they live and die with the controller and each uses a filled diamond (Table 1..*; Waiter, Chef, Cashier, WaitingQueue, Menu, ArrivalSchedule 1 each). Contrast: a hollow diamond (aggregation) would mean the part can exist without the controller." vertex="1">
          <mxGeometry height="170" width="400" x="1230" y="560" as="geometry" />
        </mxCell>
        <mxCell id="dep-gc-customer" edge="1" parent="1" source="GameController" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5441;exitDx=0;exitDy=0;entryX=1;entryY=0.7359;entryDx=0;entryDy=0;endArrow=open;endFill=0;dashed=1;" target="Customer" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dep-gc-order" edge="1" parent="1" source="GameController" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.6471;exitDx=0;exitDy=0;entryX=1;entryY=0.2455;entryDx=0;entryDy=0;endArrow=open;endFill=0;dashed=1;" target="Order" value="">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="1000" /><mxPoint x="480" y="1178" /></Array></mxGeometry>
        </mxCell>
